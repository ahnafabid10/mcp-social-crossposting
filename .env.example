# ==============================================================================
# UNIVERSAL SOCIAL MEDIA MCP SERVER - CONFIGURATION
# ==============================================================================
# 💡 RECOMMENDED: Use the 1-Click OAuth Assistant!
# Run `npm run auth` to open the web dashboard at http://localhost:3456
# and connect your accounts with a single click.
# ==============================================================================

# OAuth Server Port & Host
AUTH_PORT=3456
REDIRECT_HOST=http://localhost:3456

# ------------------------------------------------------------------------------
# 1. GOOGLE (YouTube & Shorts) OAuth App Credentials
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3456/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 2. META (Facebook, Instagram & Threads) OAuth App Credentials
# Create App at https://developers.facebook.com
# Add "Facebook Login" with redirect URI: http://localhost:3456/callback/meta
# ------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

# ------------------------------------------------------------------------------
# 3. X / TWITTER (OAuth 2.0 PKCE)
# Create App at https://developer.twitter.com
# Callback URL: http://localhost:3456/callback/twitter
# ------------------------------------------------------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. BLUESKY & MASTODON (NO App ID needed!)
# You can connect directly from http://localhost:3456
# Or fill in below:
# ------------------------------------------------------------------------------
BLUESKY_IDENTIFIER=
BLUESKY_PASSWORD=

MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ==============================================================================
# MANUAL FALLBACKS (Optional: only needed if NOT using OAuth)
# ==============================================================================
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
YOUTUBE_REFRESH_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
